print("🔍 Intercepting RemoteEvent calls...")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local origFireServer = Instance.new("RemoteEvent").FireServer

local function hookRemote(remote)
	if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
		local originalFire = remote.FireServer
		
		function remote:FireServer(...)
			print("📡 RemoteEvent fired: " .. remote:GetFullName())
			print("   Args: ", ...)
			return originalFire(self, ...)
		end
	end
end

-- Hook all existing remotes
for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
	if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
		hookRemote(obj)
		print("✅ Hooked: " .. obj:GetFullName())
	end
end

-- Hook new remotes as they're created
ReplicatedStorage.ChildAdded:Connect(function(child)
	if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
		hookRemote(child)
		print("✅ Hooked new remote: " .. child:GetFullName())
	end
end)

print("✅ RemoteEvent logger active! Try sending a trade and check console.")
