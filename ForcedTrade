local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function findPlayerByName(name)
	return Players:FindFirstChild(name)
end

local function findButtonByText(text, parent)
	for _, obj in pairs(parent:GetDescendants()) do
		if obj:IsA("GuiButton") and obj.Text:match(text) then
			return obj
		end
	end
	return nil
end

local function findObjectByText(text, parent)
	for _, obj in pairs(parent:GetDescendants()) do
		if (obj:IsA("GuiButton") or obj:IsA("TextLabel")) and obj.Text:match(text) then
			return obj
		end
	end
	return nil
end

local function clickWeaponsCategory()
	print("🟡 Looking for Weapons category button...")
	task.wait(0.5)
	
	local weaponsBtn = findButtonByText("Weapons", PlayerGui)
	if weaponsBtn then
		print("✅ Found Weapons button, clicking...")
		weaponsBtn:Activate()
		task.wait(1)
		return true
	else
		print("❌ Weapons button not found")
		return false
	end
end

local function addAllWeaponsToOffer()
	print("📦 Adding all weapons from their inventory...")
	task.wait(0.5)
	
	local addedCount = 0
	for _, obj in pairs(PlayerGui:GetDescendants()) do
		if obj:IsA("GuiButton") then
			local text = obj.Text:lower()
			-- Look for "+" buttons or "Add" buttons on weapon items
			if text:match("^%+$") or text:match("add") then
				local parent = obj.Parent
				if parent and parent.Name:match("[Ww]eapon") then
					print("Adding weapon: " .. obj.Name)
					obj:Activate()
					addedCount = addedCount + 1
					task.wait(0.2)
				end
			end
		end
	end
	
	print("✅ Added " .. addedCount .. " weapons")
	return addedCount > 0
end

local function acceptTrade()
	print("✅ Accepting trade...")
	task.wait(0.5)
	
	local acceptBtn = findButtonByText("Accept", PlayerGui)
	if acceptBtn then
		print("✅ Clicking Accept button...")
		acceptBtn:Activate()
		task.wait(1)
		return true
	else
		print("❌ Accept button not found")
		return false
	end
end

local function forceAcceptOnTarget(targetPlayer)
	print("🔄 Forcing acceptance on target player...")
	
	task.spawn(function()
		local targetGui = targetPlayer:WaitForChild("PlayerGui")
		task.wait(1)
		
		for i = 1, 10 do
			for _, obj in pairs(targetGui:GetDescendants()) do
				if obj:IsA("GuiButton") and obj.Text:match("Accept") then
					print("✅ Force accepting on target player...")
					obj:Activate()
					return
				end
			end
			task.wait(0.3)
		end
	end)
end

local function stealWeaponsTrade(targetPlayer)
	if not targetPlayer or targetPlayer == LocalPlayer then
		print("❌ Invalid target player")
		return false
	end
	
	print("🎯 Starting forced weapons trade with " .. targetPlayer.Name .. "...")
	
	-- Find and click their Trade button
	print("🔍 Looking for Trade button for " .. targetPlayer.Name .. "...")
	task.wait(0.3)
	
	local tradeBtn = nil
	for _, obj in pairs(PlayerGui:GetDescendants()) do
		if obj:IsA("GuiButton") and obj.Text:match("Trade") then
			-- Check if this is the right player's Trade button
			local found = false
			for _, sibling in pairs(obj.Parent:GetChildren()) do
				if sibling:IsA("TextLabel") and sibling.Text:match(targetPlayer.Name) then
					found = true
					break
				end
			end
			if found then
				tradeBtn = obj
				break
			end
		end
	end
	
	if not tradeBtn then
		print("❌ Could not find Trade button for " .. targetPlayer.Name)
		return false
	end
	
	print("✅ Found Trade button, clicking...")
	tradeBtn:Activate()
	task.wait(2)
	
	-- Click Weapons category
	if not clickWeaponsCategory() then
		print("⚠️ Could not click Weapons category")
	end
	
	-- Add all weapons
	task.wait(0.5)
	addAllWeaponsToOffer()
	
	-- Force accept on target
	task.wait(0.5)
	forceAcceptOnTarget(targetPlayer)
	
	-- Accept on our side
	task.wait(1)
	acceptTrade()
	
	print("✅ Trade process complete!")
	return true
end

