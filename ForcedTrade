button.MouseButton1Click:Connect(function()
	local playerName = inputBox.Text:match("^%s*(.-)%s*$")
	
	if playerName == "" or playerName == nil then
		button.Text = "ENTER NAME"
		task.wait(2)
		button.Text = "TRADE"
		return
	end
	
	local target = findPlayerByName(playerName)
	
	if not target then
		button.Text = "NOT FOUND"
		task.wait(2)
		button.Text = "TRADE"
		return
	end
	
	button.Text = "TRADING..."
	forcedTrade(target)
	task.wait(2)
	button.Text = "TRADE"
end)

