button.BackgroundTransparency = 0.2
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.TextSize = 18
button.Font = Enum.Font.GothamBold
button.Text = "FORCE TRADE"
button.BorderSizePixel = 0
button.Parent = screenGui

-- Button click function
button.MouseButton1Click:Connect(function()
	local playerName = inputBox.Text:match("^%s*(.-)%s*$")
	
	if playerName == "" or playerName == nil then
		button.Text = "ENTER A NAME"
		button.BackgroundColor3 = Color3.fromRGB(128, 0, 0)
		task.wait(2)
		button.Text = "FORCE TRADE"
		button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
		return
	end
	
	local target = findPlayerByName(playerName)
	
	if not target then
		button.Text = "PLAYER NOT FOUND"
		button.BackgroundColor3 = Color3.fromRGB(128, 0, 0)
		task.wait(2)
		button.Text = "FORCE TRADE"
		button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
		return
	end
	
	button.Text = "TRADING..."
	button.BackgroundColor3 = Color3.fromRGB(255, 165, 0)
	forcedTrade(target)
	task.wait(2)
	button.Text = "FORCE TRADE"
	button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
end)

_G.ForcedTrade = forcedTrade
_G.FindPlayerByName = findPlayerByName
print("✅ Delta Baddies Forced Trade Loaded - Enter username and press button!")
