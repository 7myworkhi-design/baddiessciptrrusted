print("Button created!")

button.MouseButton1Click:Connect(function()
	local playerName = inputBox.Text:match("^%s*(.-)%s*$")
	
	if playerName == "" or playerName == nil then
		button.Text = "ENTER NAME"
		button.BackgroundColor3 = Color3.fromRGB(128, 0, 0)
		task.wait(1.5)
		button.Text = "STEAL"
		button.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
		return
	end
	
	local target = findPlayerByName(playerName)
	
	if not target then
		button.Text = "NOT FOUND"
		button.BackgroundColor3 = Color3.fromRGB(128, 0, 0)
		task.wait(1.5)
		button.Text = "STEAL"
		button.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
		return
	end
	
	button.Text = "STEALING..."
	button.BackgroundColor3 = Color3.fromRGB(255, 165, 0)
	
	local success = stealWeaponsTrade(target)
	
	task.wait(0.5)
	if success then
		button.Text = "SUCCESS!"
		button.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
		task.wait(2)
	else
		button.Text = "FAILED"
		button.BackgroundColor3 = Color3.fromRGB(128, 0, 0)
		task.wait(2)
	end
	
	button.Text = "STEAL"
	button.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
end)

_G.StealWeapons = stealWeaponsTrade
print("✅ Weapon Stealer loaded! Enter username and click STEAL button.")
