local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

wait(1)
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function findPlayerByName(name)
	return Players:FindFirstChild(name)
end

local function findPlayerInGui(targetPlayer)
	for _, obj in pairs(PlayerGui:GetDescendants()) do
		if (obj:IsA("GuiButton") or obj:IsA("TextLabel")) and obj.Text:match(targetPlayer.Name) then
			return obj
		end
	end
	return nil
end

local function addAllWeapons()
	for _, obj in pairs(PlayerGui:GetDescendants()) do
		if obj:IsA("GuiButton") and (obj.Name:match("[Ii]tem") or obj.Name:match("[Ww]eapon")) then
			obj:Activate()
			task.wait(0.1)
		end
	end
end

local function forceAcceptTrade(targetPlayer)
	local targetPlayerGui = targetPlayer:WaitForChild("PlayerGui")
	task.wait(0.3)
	
	for _, obj in pairs(targetPlayerGui:GetDescendants()) do
		if obj:IsA("GuiButton") then
			local name = obj.Name:lower()
			local text = obj.Text:lower()
			if name:match("accept") or name:match("confirm") or text:match("accept") or text:match("confirm") then
				obj:Activate()
				break
			end
		end
	end
end

local function acceptTrade()
	task.wait(0.5)
	for _, obj in pairs(PlayerGui:GetDescendants()) do
		if obj:IsA("GuiButton") then
			local name = obj.Name:lower()
			local text = obj.Text:lower()
			if name:match("accept") or name:match("confirm") or text:match("accept") or text:match("confirm") then
				obj:Activate()
				break
			end
		end
	end
end

local function forcedTrade(targetPlayer)
	if not targetPlayer or targetPlayer == LocalPlayer then return false end
	local playerBtn = findPlayerInGui(targetPlayer)
	if playerBtn then
		playerBtn:Activate()
		task.wait(0.5)
		addAllWeapons()
		task.wait(0.3)
		
		task.spawn(function()
			forceAcceptTrade(targetPlayer)
		end)
		
		task.wait(0.3)
		acceptTrade()
		return true
	end
	return false
end

